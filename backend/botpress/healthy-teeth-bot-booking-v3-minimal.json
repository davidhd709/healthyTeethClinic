              "id": "ins-0aef120965",
              "type": "action",
              "category": "Execute",
              "code": "try {\n  // URL publica de tu backend (accesible desde Botpress Cloud)\n  const apiBase = 'https://TU_BACKEND_PUBLICO';\n\n  if (!user.bookingState || typeof user.bookingState !== 'object') {\n    user.bookingState = {};\n  }\n\n  const payload = {\n    message: event.preview || '',\n    state: user.bookingState\n  };\n\n  const res = await axios.post(apiBase + '/api/bot/booking/turn', payload);\n\n  if (res?.data?.state) {\n    user.bookingState = res.data.state;\n  }\n\n  workflow.respuesta =\n    res?.data?.reply || 'No pude procesar tu solicitud en este momento.';\n\n} catch (err) {\n  const detail = err?.response?.data?.message || err?.message || 'Error inesperado';\n  workflow.respuesta = 'No pude conectar con el sistema de agenda. ' + detail;\n}\n",
              "origin": "builtin",
              "label": "\"Booking Turn via Backend API\"",
