    {
      "id": "hk-1q8lg5q",
      "name": "inject_learnings",
      "hookType": "before_llmz_execution",
      "content": "async function runFindFeedback() {\n  const search = context.transcript.map((x) => `${x.role}: ${x.content}`).join(\"\\n\")\n  if (!search) {\n    // nothing to search for\n    return\n  }\n\n  const { items } = await actions[\"agi/improvement\"].findFeedback({\n    uri: `workflow://${context.location?.workflowId}/${context.location?.nodeId}`,\n    search,\n  });\n\n  if (!items.length) {\n    return\n  }\n\n  context.instructions += `\n\n## Learnings from Previous Experiences\n\n${items\n  .map(\n    (x, i) => `### Learning ${i + 1}\n${x.learning}\n`\n  )\n  .join(\"\\n\")}\n  `;\n}\n\nawait runFindFeedback()",
      "title": "Provide Learnings to LLMz",
      "description": "This hook injects learnings into LLMz before execution",
      "origin": {
        "type": "integration",
        "integration": {
          "id": "agi/improvement",
          "name": "agi/improvement",
          "version": "1.0.2",
          "title": "Improvement"
        }
      },
      "transpiledCode": "var __defProp = Object.defineProperty;\nvar __name = (target, value) => __defProp(target, \"name\", { value, configurable: true });\nasync function __ROOT__() {\n  async function runFindFeedback() {\n    const search = context.transcript.map((x) => `${x.role}: ${x.content}`).join(\"\\n\");\n    if (!search) {\n      return;\n    }\n    const { items } = await actions[\"agi/improvement\"].findFeedback({\n      uri: `workflow://${context.location?.workflowId}/${context.location?.nodeId}`,\n      search\n    });\n    if (!items.length) {\n      return;\n    }\n    context.instructions += `\n\n## Learnings from Previous Experiences\n\n${items.map(\n      (x, i) => `### Learning ${i + 1}\n${x.learning}\n`\n    ).join(\"\\n\")}\n  `;\n  }\n  __name(runFindFeedback, \"runFindFeedback\");\n  await runFindFeedback();\n}\n__name(__ROOT__, \"__ROOT__\");\n; return await __ROOT__();"
